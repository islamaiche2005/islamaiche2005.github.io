# File names under /assets/ contain a content hash: a new release gets new names, so they can be
# cached for a year and never re-downloaded.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/brands/*
  Cache-Control: public, max-age=604800

# Always go straight to https (avoids the plain-http path that mobile operator proxies time out on).
/*
  Strict-Transport-Security: max-age=31536000
